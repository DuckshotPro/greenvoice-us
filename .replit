modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Reorganize server directories"
author = 41040400
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p server/controllers"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p server/models"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p server/routes"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p server/middleware"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p server/services"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p server/utils"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/auth.ts server/middleware/auth.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/db.ts server/models/db.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/invoice-processor.ts server/services/invoice-processor.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/lib/error-logger.ts server/utils/error-logger.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/lib/discount-calculator.ts server/utils/discount-calculator.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/scheduler.ts server/controllers/scheduler.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/routes.ts server/routes/routes.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mv server/storage.ts server/models/storage.ts"
